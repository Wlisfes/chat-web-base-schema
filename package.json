{
  "name": "@wlisfes/chat-web-base-schema",
  "version": "0.1.0",
  "description": "Shared MySQL schemas, TypeORM entities and migrations for chat-web services",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wlisfes/chat-web-base-schema.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chat-web-account-mysql": {
      "types": "./dist/chat-web-account-mysql/index.d.ts",
      "require": "./dist/chat-web-account-mysql/index.js",
      "default": "./dist/chat-web-account-mysql/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:generate:account": "typeorm-ts-node-commonjs migration:generate ./chat-web-account-mysql/migrations/SchemaChange -d ./chat-web-account-mysql/data-source.ts",
    "migration:create:account": "typeorm migration:create ./chat-web-account-mysql/migrations/SchemaChange",
    "migration:run:account": "typeorm-ts-node-commonjs migration:run -- -d ./chat-web-account-mysql/data-source.ts",
    "migration:show:account": "typeorm-ts-node-commonjs migration:show -- -d ./chat-web-account-mysql/data-source.ts",
    "migration:revert:account": "typeorm-ts-node-commonjs migration:revert -- -d ./chat-web-account-mysql/data-source.ts",
    "prepublishOnly": "yarn typecheck && yarn build"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": ">=0.3.31 <1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.1",
    "mysql2": "^3.23.3",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "0.3.31",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.21"
  }
}
