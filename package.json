{
  "name": "@wlisfes/chat-web-base-schema",
  "version": "0.1.0",
  "description": "Shared TypeORM MySQL table definitions for chat-web services",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wlisfes/chat-web-base-schema.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chat-web-account-mysql": {
      "types": "./dist/src/schem/chat-web-account-mysql/index.d.ts",
      "require": "./dist/src/schem/chat-web-account-mysql/index.js",
      "default": "./dist/src/schem/chat-web-account-mysql/index.js"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "require": "./dist/src/utils/index.js",
      "default": "./dist/src/utils/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "yarn typecheck && yarn build"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": ">=0.3.31 <1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "typeorm": "0.3.31",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.21"
  }
}
